# Postgres connection string (docker compose up -d db gives you this one)
DATABASE_URL=postgres://noelons:noelons@localhost:5432/noelons

# Public origin, used for RSS/absolute links
PUBLIC_URL=http://localhost:3000

# Where uploaded media is written by the local storage driver
MEDIA_DIR=./.data/media

# Password for the seeded demo accounts (dev only)
SEED_PASSWORD=noelons-demo

# Number of reverse proxies / load balancers in front of the app (for client IPs)
TRUST_PROXY_HOPS=1
